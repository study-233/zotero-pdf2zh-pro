{
  "name": "zotero-pdf2zh-pro-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "docs:sync": "node scripts/python.mjs sync_guide_docs.py",
    "docs:check": "node scripts/python.mjs sync_guide_docs.py --check",
    "prepare:data": "node scripts/python.mjs prepare_website_data.py && node scripts/prepare-next.mjs",
    "docs:generate:styles": "node scripts/generate-fumadocs-scoped-css.mjs",
    "dev": "pnpm prepare:data && pnpm docs:generate:styles && next dev --webpack --hostname 127.0.0.1",
    "check": "fumadocs-mdx && tsc --noEmit",
    "build": "pnpm prepare:data && pnpm docs:generate:styles && next build --webpack && node scripts/finish-next.mjs",
    "preview": "node scripts/python.mjs serve_site.py --port 8897",
    "test": "node --test scripts/*.test.mjs",
    "build:legacy": "node scripts/python.mjs build_site.py"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fumadocs-core": "16.15.4",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-ui": "16.15.4",
    "lucide-react": "1.37.0",
    "next": "16.4.1",
    "next-themes": "0.4.6",
    "postcss": "8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "4.4.3",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
