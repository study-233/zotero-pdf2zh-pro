task-memory-sync-pending = PDF is ready; translation memory sync runs in the background and retries automatically.
task-memory-sync-retry = Retry memory sync
notice-error-favorites-protected = The favorites file is unavailable or has changed. Writes are paused. Back up and restore the library, then restart Zotero.
