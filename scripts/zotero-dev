#!/usr/bin/env bash
set -euo pipefail

# Resolve the installed symlink so the command works from any directory.
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
    SOURCE_DIR="$(cd -- "$(dirname -- "$SOURCE")" && pwd)"
    SOURCE="$(readlink -- "$SOURCE")"
    [[ "$SOURCE" == /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -- "$(dirname -- "$SOURCE")" && pwd)"

case "${1:-}" in
    ""|dev|formal) exec "$SCRIPT_DIR/dev.sh" switch "$@" ;;
    *) exec "$SCRIPT_DIR/dev.sh" "$@" ;;
esac
