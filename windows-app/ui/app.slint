import { Button, CheckBox, LineEdit, Switch, ComboBox, ScrollView, ProgressIndicator, Palette } from "std-widgets.slint";

export struct DownloadRow { name: string, detail: string, progress: float, known: bool }

export global Appearance {
    in-out property <bool> high-contrast: false;
    in-out property <color> system-background: white;
    in-out property <color> system-foreground: black;
    out property <brush> background: high-contrast ? system-background : Palette.background;
    out property <brush> foreground: high-contrast ? system-foreground : Palette.foreground;
    out property <brush> card: high-contrast ? system-background : Palette.alternate-background;
    out property <brush> border: high-contrast ? system-foreground : Palette.border;
}
component Label inherits Text { color: Appearance.foreground; wrap: word-wrap; }
component Caption inherits Label { font-size: 0.86rem; opacity: Appearance.high-contrast ? 1 : 0.75; }
component Card inherits Rectangle {
    background: Appearance.card; border-color: Appearance.border; border-width: 1px; border-radius: 8px;
    @children
}
component SettingRow inherits HorizontalLayout {
    in property <string> name;
    in property <string> description;
    spacing: 16px;
    VerticalLayout {
        spacing: 4px; horizontal-stretch: 1;
        Label { text: root.name; font-weight: 600; }
        Caption { text: root.description; }
    }
    @children
}
component OperationFeedback inherits VerticalLayout {
    in property <string> message;
    in property <string> detail;
    in property <float> progress;
    in property <bool> active;
    in property <bool> known;
    in property <bool> animate;
    spacing: 10px; vertical-stretch: 0;
    if root.message != "": HorizontalLayout {
        spacing: 12px;
        Label { text: root.message; horizontal-stretch: 1; }
    }
    if root.known: ProgressIndicator { progress: root.progress; height: 6px; accessible-label: "当前文件进度"; }
    if root.detail != "": Caption { text: root.detail; }
}

component DownloadList inherits VerticalLayout {
    in property <[DownloadRow]> files;
    spacing: 12px; vertical-stretch: 0;
    for file in root.files: VerticalLayout {
        spacing: 6px; vertical-stretch: 0;
        Label { text: file.name; overflow: elide; wrap: no-wrap; }
        if file.known: ProgressIndicator { progress: file.progress; height: 6px; accessible-label: file.name + "下载进度"; }
        Caption { text: file.detail; }
    }
}
component LogView inherits ScrollView {
    in property <string> text;
    in-out property <bool> follow: true;
    in-out property <length> offset;
    callback position-changed();
    preferred-height: 150px; min-height: 80px; vertical-stretch: 1;
    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
    content-width: root.visible-width;
    content-height: max(root.visible-height, log-text.preferred-height + 8px);
    content-y: root.follow ? min(0px, root.visible-height - root.content-height) : root.offset;
    changed content-height => { if root.follow { root.content-y = min(0px, root.visible-height - root.content-height); } }
    changed visible-height => { if root.follow { root.content-y = min(0px, root.visible-height - root.content-height); } }
    changed follow => { if root.follow { root.content-y = min(0px, root.visible-height - root.content-height); } }
    changed offset => { if !root.follow { root.content-y = root.offset; } }
    scrolled => {
        root.follow = root.content-y <= min(0px, root.visible-height - root.content-height) + 12px;
        root.offset = root.content-y;
        root.position-changed();
    }
    log-text := Label { text: root.text; y: 4px; width: root.visible-width - 16px; height: self.preferred-height; font-size: 0.86rem; }
}
component SettingsFeedback inherits VerticalLayout {
    in property <string> message;
    in property <string> detail;
    in property <string> logs;
    in property <float> progress;
    in property <bool> known;
    in property <bool> failed;
    in property <bool> busy;
    in property <[DownloadRow]> files;
    in-out property <bool> expanded;
    callback retry();
    callback copy();
    callback log();
    callback state-changed();
    spacing: 10px;
    OperationFeedback { message: root.message; detail: root.detail; progress: root.progress; known: root.known; }
    if root.files.length == 1: DownloadList { files: root.files; }
    if root.files.length > 1: ScrollView { height: 132px;
        VerticalLayout { padding-right: 8px; alignment: start; DownloadList { files: root.files; } }
    }
    if root.expanded || root.failed || root.logs != "暂无详情。": HorizontalLayout { spacing: 8px;
        Button { text: root.expanded ? "收起详情" : "查看详情"; clicked => { root.expanded = !root.expanded; root.state-changed(); } }
        if root.failed: Button { text: "重试"; enabled: !root.busy; clicked => { root.retry(); } }
        Rectangle { horizontal-stretch: 1; }
    }
    if root.expanded: VerticalLayout { spacing: 8px;
        LogView { text: root.logs; height: 120px; }
        HorizontalLayout { spacing: 8px;
            Button { text: "复制详情"; clicked => { root.copy(); } }
            Button { text: "打开日志"; clicked => { root.log(); } }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}


component SectionHeader inherits Rectangle {
    in property <string> title;
    in property <string> summary;
    in property <bool> expanded;
    callback toggled();
    min-height: 44px; vertical-stretch: 0;
    border-radius: 7px;
    background: hit.pressed ? Palette.alternate-background : hit.has-hover ? Palette.background : transparent;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Appearance.high-contrast ? Appearance.foreground : Palette.accent-background;
    accessible-role: button;
    accessible-label: (root.expanded ? "收起" : "展开") + root.title;
    accessible-expanded: root.expanded;
    accessible-action-default => { root.toggled(); }
    forward-focus: focus;
    HorizontalLayout {
        padding: 14px; padding-top: 11px; padding-bottom: 11px; spacing: 10px;
        Label { text: root.title; font-weight: 600; vertical-alignment: center; }
        Caption { text: root.expanded ? "" : root.summary; horizontal-stretch: 1;
            horizontal-alignment: right; vertical-alignment: center; overflow: elide; wrap: no-wrap; min-width: 0px; }
        Rectangle { width: 14px; horizontal-stretch: 0;
            Image { source: @image-url("../../plugin/addon/content/icons/preferences/chevron-right.svg");
                width: 14px; height: 14px; y: (parent.height - self.height) / 2;
                colorize: Appearance.foreground; transform-rotation: root.expanded ? 90deg : 0deg; }
        }
    }
    hit := TouchArea { mouse-cursor: pointer;
        clicked => { focus.focus(); root.toggled(); } }
    focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.toggled(); return accept;
            }
            return reject;
        }
    }
}
component FoldSection inherits Card {
    in property <string> title;
    in property <string> summary;
    in-out property <bool> expanded;
    callback toggled();
    vertical-stretch: 0;
    VerticalLayout { padding: 1px; spacing: 0px;
        SectionHeader { title: root.title; summary: root.summary; expanded: root.expanded;
            toggled => { root.expanded = !root.expanded; root.toggled(); } }
        if root.expanded: Rectangle { height: 1px; background: Appearance.border; }
        Rectangle { visible: root.expanded; vertical-stretch: 0;
            min-height: root.expanded ? body.min-height : 0px;
            preferred-height: root.expanded ? body.preferred-height : 0px;
            max-height: root.expanded ? 100000px : 0px;
            body := VerticalLayout { padding: 14px; padding-bottom: 16px; spacing: 14px; @children }
        }
    }
}

export component AppWindow inherits Window {
    title: "zotero-pdf2zh-pro";
    icon: @image-url("../../assets/logo.png");
    preferred-width: 560px;
    preferred-height: 680px;
    min-width: 460px;
    min-height: 420px;
    background: Appearance.background;
    in property <float> text-scale: 1;
    default-font-size: 14px * root.text-scale;
    in property <int> page;
    in property <int> wizard-stage;
    in property <bool> setup-mode;
    in property <string> heading: "正在检测服务…";
    in property <string> subtitle;
    in property <string> address;
    in property <string> app-version;
    in property <string> version;
    in property <string> action-label: "正在检测";
    in property <string> operation-message;
    in property <string> operation-detail;
    in property <float> progress;
    in property <bool> progress-known;
    in property <bool> progress-active;
    in property <bool> animate: true;
    in property <bool> busy;
    in property <bool> failed;
    in property <bool> cancelled;
    in property <bool> cancelling;
    in property <bool> can-cancel;
    in property <int> operation-step;
    in property <string> elapsed;
    in property <bool> ready;
    in property <bool> existing;
    in property <bool> installed;
    in property <bool> downgrade;
    in property <bool> can-relocate;
    in property <string> details;
    in property <[DownloadRow]> active-files;
    in-out property <bool> details-open;
    in-out property <bool> follow-logs: true;
    in-out property <length> log-offset;
    callback details-state(bool, bool, float);
    in property <string> confirmation;
    in property <bool> confirm-uninstall;
    in property <bool> confirm-cancel;
    in-out property <bool> purge-data: false;
    callback purge-changed(bool);
    in property <bool> copied;
    in-out property <int> theme;
    in property <int> effective-theme;
    in-out property <bool> autostart;
    in-out property <bool> automatic-updates;
    in-out property <string> install-path;
    in-out property <bool> advanced: false;
    in-out property <float> settings-offset;
    in-out property <bool> update-details-open;
    in-out property <bool> maintenance-details-open;
    in property <string> settings-notice;
    in property <string> update-message;
    in property <string> update-checked;
    in property <bool> update-checking;
    in property <bool> update-pending;
    in property <bool> update-available;
    in property <string> update-action-label: "下载并更新";
    in property <bool> update-failed;
    in property <string> update-detail;
    in property <string> update-logs;
    in property <float> update-progress;
    in property <bool> update-progress-known;
    in property <[DownloadRow]> update-files;
    in property <string> maintenance-message;
    in property <string> maintenance-detail;
    in property <string> maintenance-logs;
    in property <bool> maintenance-failed;
    in property <float> maintenance-progress;
    in property <bool> maintenance-progress-known;
    in property <[DownloadRow]> maintenance-files;
    callback settings-state();
    callback action(string);
    callback preferences(int, bool, bool);
    callback install(string, bool, bool);
    callback path-edited(string);
    callback draft-options(bool, bool);
    changed effective-theme => { Palette.color-scheme = root.effective-theme == 1 ? ColorScheme.light : root.effective-theme == 2 ? ColorScheme.dark : ColorScheme.unknown; }

    in property <int> status-tone;
    in property <bool> primary-enabled;
    in property <bool> service-running;
    in property <bool> service-fault;
    in property <bool> service-operation;
    in property <string> data-path;
    in-out property <bool> connection-open;
    in-out property <bool> installation-open;
    in-out property <bool> updates-open;
    in-out property <bool> general-open;
    in-out property <bool> about-open;

    content := VerticalLayout {
        padding: 20px; spacing: 16px;
        Card { vertical-stretch: 0; VerticalLayout {
            padding: 18px; spacing: 12px;
            HorizontalLayout { spacing: 10px;
                Rectangle { width: 9px; horizontal-stretch: 0;
                    Rectangle { width: 9px; height: 9px; y: (parent.height - self.height) / 2; border-radius: 5px;
                        background: Appearance.high-contrast ? Appearance.foreground : root.status-tone == 2 ? #16803c : root.status-tone == 3 ? #c43c35 : root.status-tone == 1 ? Palette.accent-background : #777;
                    }
                }
                Label { text: root.heading; font-size: 1.43rem; font-weight: 600; horizontal-stretch: 1; }
                Caption { text: root.app-version; vertical-alignment: center; wrap: no-wrap; }
            }
            if root.subtitle != "": Caption { text: root.subtitle; }
            HorizontalLayout { spacing: 10px;
                Button { text: root.action-label; primary: true; horizontal-stretch: 1; enabled: root.primary-enabled;
                    clicked => { root.action("primary"); } }
                if root.service-running: Button { text: "停止服务"; enabled: !root.busy && !root.update-pending; clicked => { root.action("stop"); } }
                if root.service-fault && root.action-label != "重新检测": Button { text: "重新检测"; enabled: !root.busy; clicked => { root.action("refresh"); } }
                Button { text: "后台运行"; clicked => { root.action("background"); } }
            }
            if root.service-operation && root.operation-message != "": OperationFeedback {
                message: root.operation-message; detail: root.operation-detail;
                progress: root.progress; known: root.progress-known; active: root.progress-active; animate: root.animate;
            }
        }}
        if root.settings-notice != "": Label { text: root.settings-notice; }
        home-scroll := ScrollView {
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            content-width: self.visible-width;
            content-y: root.settings-offset * 1px;
            scrolled => { root.settings-offset = self.content-y / 1px; root.settings-state(); }
            VerticalLayout { spacing: 10px; padding-right: 8px; alignment: start;
                if root.page == 4: Card { vertical-stretch: 0; VerticalLayout {
                    padding: 16px; spacing: 12px;
                    Label { text: root.confirm-cancel ? "取消安装？" : root.confirm-uninstall ? "卸载翻译服务？" : "确认操作"; font-weight: 600; }
                    Label { text: root.confirmation; }
                    if root.confirm-uninstall: VerticalLayout { spacing: 8px;
                        CheckBox { text: "同时删除配置、数据和日志"; checked <=> root.purge-data; toggled => { root.purge-changed(root.purge-data); } }
                        Caption { text: root.purge-data ? "将删除配置、翻译任务、结果和日志，无法撤销。" : "配置、翻译任务、结果和日志将保留。"; }
                    }
                    HorizontalLayout { spacing: 10px;
                        Button { text: root.confirm-cancel ? "继续安装" : "取消"; clicked => { root.action("back"); } }
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: root.confirm-cancel ? "取消安装" : root.confirm-uninstall ? "卸载" : "继续"; primary: true;
                            enabled: root.confirm-cancel ? root.can-cancel && !root.cancelling : !root.busy && !root.update-pending;
                            clicked => { root.action(root.confirm-cancel ? "cancel-install-now" : "confirm"); } }
                    }
                }}
                FoldSection { title: "连接信息"; summary: root.address;
                    expanded <=> root.connection-open; toggled => { root.settings-state(); }
                    HorizontalLayout { spacing: 10px;
                        LineEdit { text: root.address; read-only: true; accessible-label: "服务地址"; horizontal-stretch: 1; }
                        Button { text: root.copied ? "已复制" : "复制地址"; clicked => { root.action("copy-address"); } }
                    }
                    Caption { text: root.version; }
                    Label { text: "数据目录"; font-weight: 600; }
                    Label { text: root.data-path; }
                    Button { text: "打开数据目录"; clicked => { root.action("data"); } }
                }
                FoldSection { title: "安装与运行环境"; summary: root.setup-mode && root.wizard-stage == 1 ? root.operation-message : root.existing ? "已安装" : "尚未安装";
                    expanded <=> root.installation-open; toggled => { root.settings-state(); }
                    if !root.setup-mode: VerticalLayout { spacing: 12px;
                        Caption { text: root.install-path; }
                        Button { text: root.existing ? "升级或重新安装" : "配置安装"; enabled: !root.busy && !root.update-pending; clicked => { root.action("setup"); } }
                    }
                    if root.setup-mode && root.wizard-stage == 0: VerticalLayout { spacing: 12px;
                        Label { text: root.existing ? "升级或修复翻译服务" : "安装本地翻译服务"; font-weight: 600; }
                        Caption { text: "首次安装需要联网下载 Python 和翻译依赖。"; }
                        HorizontalLayout { spacing: 8px;
                            LineEdit { text <=> root.install-path; enabled: root.ready && !root.existing; accessible-label: "安装位置"; horizontal-stretch: 1; edited => { root.path-edited(root.install-path); } }
                            Button { text: "浏览…"; enabled: root.ready && !root.existing; clicked => { root.action("browse"); } }
                        }
                        Switch { text: "登录 Windows 后自动启动"; checked <=> root.autostart; enabled: root.ready && !root.existing; toggled => { root.draft-options(root.autostart, root.automatic-updates); } }
                        Switch { text: "空闲时自动更新"; checked <=> root.automatic-updates; enabled: root.ready && !root.existing; toggled => { root.draft-options(root.autostart, root.automatic-updates); } }
                        if root.existing || root.downgrade: Caption { text: root.downgrade ? "已安装版本更高，请使用对应版本的安装器。" : "沿用安装位置、自启选择和现有配置。"; }
                        Button { text: root.existing ? "升级 / 修复" : "开始安装"; primary: true; enabled: root.ready && !root.busy && !root.downgrade;
                            clicked => { root.install(root.install-path, root.autostart, root.automatic-updates); } }
                    }
                    if root.setup-mode && root.wizard-stage != 0: VerticalLayout { spacing: 12px;
                        Label { text: root.wizard-stage == 2 ? "安装完成" : root.cancelled ? "安装已取消" : root.cancelling ? "正在取消安装" : root.failed ? "安装未完成" : "正在安装翻译服务"; font-weight: 600; }
                        if root.wizard-stage != 2: HorizontalLayout { spacing: 8px;
                            for label[index] in ["准备环境", "下载组件", "完成配置"]: Caption {
                                text: label; font-weight: index == root.operation-step ? 600 : 400;
                                horizontal-stretch: 1;
                            }
                        }
                        Caption { text: root.elapsed; }
                        if root.failed || root.active-files.length == 0: OperationFeedback {
                            message: root.operation-message; detail: root.operation-detail; progress: root.progress; known: root.progress-known;
                        }
                        if root.active-files.length == 1: DownloadList { files: root.active-files; }
                        if root.active-files.length > 1: ScrollView { height: 132px;
                            VerticalLayout { padding-right: 8px; alignment: start; DownloadList { files: root.active-files; } }
                        }
                        HorizontalLayout { spacing: 10px;
                            if root.busy: Button { text: root.cancelling ? "正在取消…" : "取消安装"; enabled: root.can-cancel && !root.cancelling; clicked => { root.action("cancel-install"); } }
                            if (root.failed || root.cancelled) && !root.busy: Button { text: root.cancelled ? "重新安装" : "重试安装"; primary: true; clicked => { root.action("retry"); } }
                            if root.wizard-stage == 2: Button { text: root.existing ? "完成并打开控制中心" : "完成并启动服务"; primary: true; clicked => { root.action("finish"); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
                FoldSection { title: "更新"; summary: root.update-pending || root.update-failed ? root.update-message : root.automatic-updates ? "空闲时自动更新" : "自动更新已关闭";
                    expanded <=> root.updates-open; toggled => { root.settings-state(); }
                    SettingRow { name: "自动更新"; description: "仅在服务空闲时切换版本";
                        Switch { checked <=> root.automatic-updates; enabled: root.installed && !root.busy; accessible-label: "自动更新";
                            toggled => { root.preferences(root.theme, root.autostart, root.automatic-updates); } }
                    }
                    HorizontalLayout { spacing: 10px;
                        Caption { text: root.update-checked; horizontal-stretch: 1; }
                        Button { text: root.update-checking ? "正在检查…" : "检查更新"; enabled: root.installed && !root.busy && !root.update-pending; clicked => { root.action("check"); } }
                    }
                    SettingsFeedback {
                        message: root.update-message; detail: root.update-detail; logs: root.update-logs;
                        known: root.update-progress-known; progress: root.update-progress;
                        files: root.update-files; failed: root.update-failed; busy: root.busy;
                        expanded <=> root.update-details-open; state-changed => { root.settings-state(); }
                        retry => { root.action("retry-update"); } copy => { root.action("copy-update"); } log => { root.action("log"); }
                    }
                    if root.update-available: Button { text: root.update-action-label; primary: true; enabled: root.installed && !root.busy; clicked => { root.action("update"); } }
                    if root.update-available || root.update-pending: Caption { text: "服务空闲后切换版本，控制中心将在后台重新启动。"; }
                }
                FoldSection { title: "常规设置";
                    expanded <=> root.general-open; toggled => { root.settings-state(); }
                    SettingRow { name: "主题"; description: Appearance.high-contrast ? "系统高对比度优先" : "";
                        ComboBox { width: max(176px, 10rem); model: ["跟随系统", "浅色", "深色"]; current-index <=> root.theme;
                            enabled: !Appearance.high-contrast; accessible-label: "外观主题";
                            selected(_) => { root.preferences(root.theme, root.autostart, root.automatic-updates); } }
                    }
                    SettingRow { name: "登录时启动"; description: "自动启动翻译服务并驻留托盘";
                        Switch { checked <=> root.autostart; enabled: root.installed && !root.busy; accessible-label: "登录时启动";
                            toggled => { root.preferences(root.theme, root.autostart, root.automatic-updates); } }
                    }
                }
                FoldSection { title: "存储与维护";
                    expanded <=> root.advanced; toggled => { root.settings-state(); }
                    Caption { text: "安装位置"; }
                    Label { text: root.install-path; }
                    Button { text: "打开安装目录"; clicked => { root.action("location"); } }
                    SettingRow { name: "修复环境"; description: "保留配置和数据，完成后在后台重新启动";
                        Button { text: "修复"; enabled: root.installed && !root.busy && !root.update-pending; clicked => { root.action("repair"); } }
                    }
                    SettingRow { name: "安装缓存"; description: "清理后，更新或修复可能需要补下载";
                        Button { text: "清理"; enabled: root.installed && !root.busy && !root.update-pending; clicked => { root.action("clean"); } }
                    }
                    SettingRow { name: "更改安装位置"; description: "迁移配置和数据，过程需要暂停服务";
                        Button { text: "迁移"; enabled: root.can-relocate && !root.busy && !root.update-pending; clicked => { root.action("relocate"); } }
                    }
                    if root.maintenance-message != "": SettingsFeedback {
                        message: root.maintenance-message; detail: root.maintenance-detail; logs: root.maintenance-logs;
                        known: root.maintenance-progress-known; progress: root.maintenance-progress;
                        files: root.maintenance-files; failed: root.maintenance-failed; busy: root.busy || root.update-pending;
                        expanded <=> root.maintenance-details-open; state-changed => { root.settings-state(); }
                        retry => { root.action("retry-maintenance"); } copy => { root.action("copy-maintenance"); } log => { root.action("log"); }
                    }
                    Button { text: "卸载翻译服务…"; enabled: root.installed && !root.busy && !root.update-pending; clicked => { root.action("uninstall"); } }
                }
                FoldSection { title: "日志与诊断"; summary: root.failed ? "操作失败" : "";
                    expanded <=> root.details-open; toggled => { root.details-state(root.details-open, root.follow-logs, root.log-offset / 1px); }
                    LogView { text: root.details; height: 150px; follow <=> root.follow-logs; offset <=> root.log-offset;
                        position-changed => { root.details-state(root.details-open, root.follow-logs, root.log-offset / 1px); } }
                    HorizontalLayout { spacing: 8px;
                        Button { text: root.copied ? "已复制" : "复制详情"; clicked => { root.action("copy-details"); } }
                        Button { text: "打开日志"; clicked => { root.action("log"); } }
                        if !root.follow-logs: Button { text: "回到最新"; clicked => { root.follow-logs = true; root.details-state(root.details-open, root.follow-logs, root.log-offset / 1px); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
                FoldSection { title: "关于";
                    expanded <=> root.about-open; toggled => { root.settings-state(); }
                    Caption { text: root.version; }
                    SettingRow { name: "许可证"; description: "AGPL-3.0-only";
                        Button { text: "查看许可证"; clicked => { root.action("license"); } }
                    }
                    Caption { text: "感谢 PDFMathTranslate、PDFMathTranslate-next、BabelDOC、uv、Slint 及其他上游项目。"; }
                    Button { text: "第三方许可证"; clicked => { root.action("notices"); } }
                    Button { text: "退出控制中心"; enabled: !root.busy; clicked => { root.action("quit"); } }
                }
            }
        }
    }
}
